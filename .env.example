# Public PostHog project key. Leave unset to disable analytics.
POSTHOG_PROJECT_API_KEY=
# Optional ingestion host. Defaults to the EU region.
POSTHOG_API_HOST=https://eu.i.posthog.com

# Optional: signed lifecycle events to the shared Shopify operations notifier.
OPS_NOTIFIER_URL=https://shopify-ops-notifier.example.com/v1/events
OPS_NOTIFIER_SECRET=
# Unique lowercase source-app slug, also registered in the notifier service.
OPS_NOTIFIER_APP_ID=

# Optional Shopify App Pricing integration for public apps with configured plans.
SHOPIFY_APP_HANDLE=
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_API_TOKEN=
# Defaults to the current quarterly Partner API version when omitted.
SHOPIFY_PARTNER_API_VERSION=2026-07
